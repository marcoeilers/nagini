domain PyType {
    function extends_(sub: PyType, super: PyType): Bool
    function typeof(r: Ref): PyType
    function issubtype(t1: PyType, t2: PyType):Bool
    function list(t: PyType): PyType
    function list_arg(t: PyType, i: Int): PyType
    function set(t: PyType): PyType
    function set_arg(t: PyType, i: Int): PyType
    function dict(t: PyType, v: PyType): PyType
    function dict_arg(t: PyType, i: Int): PyType
    function tuple(s: Seq[PyType]): PyType
    function tuple_args(t: PyType): Seq[PyType]
    function tuple_arg(t: PyType, i: Int): PyType
    function tuple_basic(): PyType
    function union_basic(): PyType
    function Iterator(t: PyType): PyType
    function Iterator_arg(t: PyType, i: Int): PyType
    function PSeq(t: PyType): PyType
    function PSeq_arg(t: PyType, i: Int): PyType
    function PSet(t: PyType): PyType
    function PSet_arg(t: PyType, i: Int): PyType
    function PMultiset(t: PyType): PyType
    function PMultiset_arg(t: PyType, i: Int): PyType
    function get_basic(PyType): PyType
    function type(t: PyType): PyType
    function type_arg(t: PyType, i: Int): PyType
    unique function type_basic(): PyType

    unique function int(): PyType
    unique function float(): PyType
    unique function bool(): PyType
    unique function bytes(): PyType
    unique function bytearray(): PyType
    unique function PByteSeq(): PyType
    unique function range_0(): PyType
    unique function slice(): PyType
    unique function str(): PyType
    unique function object(): PyType
    unique function NoneType(): PyType
    unique function EllipsisType(): PyType
}

// The PyType domain above only exists to type check the other preamble files;
// the real one is generated by the translator, and the preamble's copy is
// dropped. Axioms therefore live in their own domain, as in tuple.sil.
domain type_types {
    // Stated with issubtype rather than extends_, because two type(..) values
    // are related to one another (see the covariance axiom below) and so must
    // not both be direct children of object.
    axiom subtype_type {
        (forall t: PyType :: { type(t) }
          issubtype(type(t), object()) && get_basic(type(t)) == type_basic())
    }

    // Every class object is a Type[object]. This follows from covariance, but
    // is stated separately so that it triggers on any occurrence of type(t).
    axiom subtype_type_object {
        (forall t: PyType :: { type(t) } issubtype(type(t), type(object())))
    }

    // For an invariant constructor, injectivity follows from the generated arg
    // axiom (issubtype(Z, list(a)) ==> list_arg(Z, 0) == a) instantiated at
    // Z == list(a). The covariant version only yields issubtype(type_arg(Z, 0),
    // a), so injectivity would otherwise only be forced indirectly, via the
    // covariance axiom plus issubtype_exclusion_2. State it directly instead.
    axiom type_arg_def {
        (forall t: PyType :: { type(t) } type_arg(type(t), 0) == t)
    }

    // Because type(..) values have no extends_ fact (see above), the standard
    // single-inheritance exclusion cannot separate them from ordinary class
    // types. This states that separation directly, exactly as
    // tuple_type_basic_1 does for tuples: whatever is a class object is not
    // also an instance of some unrelated class, and vice versa. Sound because
    // `type` is not in EXTENDABLE_BUILTINS, so no user class can subclass it.
    axiom type_type_basic {
        (forall t: PyType, Z: PyType, arg1: PyType ::
          { issubtype(Z, type(t)), issubtype(Z, arg1) }
          issubtype(Z, type(t)) && issubtype(Z, arg1) ==>
          get_basic(arg1) == type_basic() ||
          (get_basic(arg1) == object() || get_basic(arg1) == union_basic()))
    }

    // Type[C] is covariant: a class object for a subclass of C can be used
    // wherever a class object for C is expected.
    axiom subtype_type_self {
        (forall t1: PyType, t2: PyType ::
          { issubtype(type(t1), type(t2)) }
          issubtype(type(t1), type(t2)) <==> issubtype(t1, t2))
    }
}
